<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>微信截图助手</AssemblyName>
    <RootNamespace>XiaoJie</RootNamespace>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>..\assets\app.manifest</ApplicationManifest>
    <Product>微信截图助手（DeepSeek 版）</Product>
    <AssemblyTitle>微信截图助手（DeepSeek 版）</AssemblyTitle>
    <Description>微信风格截图 + DeepSeek 文字提取 / 翻译 / 智能打码，绿色免安装</Description>
    <Company>XiaoJie</Company>
    <Copyright>Copyright © 2026 XiaoJie</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\emoji\*.png" LogicalName="emoji.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
