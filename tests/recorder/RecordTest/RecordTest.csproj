<Project Sdk="Microsoft.NET.Sdk">

  <!-- recorder 模块独立验证程序：只编译 src 中录屏相关文件 + 本 Program.cs，
       不包含主项目其它文件，方便在真实桌面上录 2~3 秒并检查产物。
       构建：dotnet build tests\recorder\RecordTest\RecordTest.csproj -c Release -o build_recorder\recordtest
       运行：$env:XJ_RECORD_AUTO_STOP_MS=2500; .\build_recorder\recordtest\recordtest.exe <保存目录> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>recordtest</AssemblyName>
    <RootNamespace>RecordTest</RootNamespace>
    <StartupObject>RecordTest.Program</StartupObject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>recorder 录屏模块离屏验证</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\src\Util.cs" Link="src\Util.cs" />
    <Compile Include="..\..\..\src\AppConfig.cs" Link="src\AppConfig.cs" />
    <Compile Include="..\..\..\src\AviWriter.cs" Link="src\AviWriter.cs" />
    <Compile Include="..\..\..\src\ScreenRecorder.cs" Link="src\ScreenRecorder.cs" />
  </ItemGroup>

</Project>
